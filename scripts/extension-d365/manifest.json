{
  "manifest_version": 3,
  "name": "Herogra · abrir factura en D365",
  "version": "1.1",
  "description": "Abre en una pestaña de tu Chrome la vista previa del original de una factura emitida de cliente en D365, cuando lo pide la aplicación de impuestos (botón 🔎 D365 de Emitidas).",
  "key": "",
  "permissions": [
    "debugger",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://herogra.operations.dynamics.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "externally_connectable": {
    "matches": [
      "https://pablooliva78.github.io/*"
    ]
  }
}